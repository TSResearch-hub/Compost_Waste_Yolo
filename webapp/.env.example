# Copier vers webapp/.env (jamais commité, ignoré par webapp/.gitignore)
# et remplir. Aucune valeur réelle dans ce fichier d'exemple.

# Connexion applicative PostgreSQL (driver psycopg v3).
# En dev : instance hébergée (Neon/Supabase), données de test uniquement.
DATABASE_URL=postgresql+psycopg://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/BASE

# Racine du stockage des fichiers images (originaux et crops, chemins en base
# relatifs à cette racine).
STORAGE_ROOT=/chemin/absolu/vers/stockage_images

# Référentiel de classes : le data.yaml du repo d'entraînement.
# Seul endroit où les classes sont définies — jamais recopiées en dur.
DATA_YAML_PATH=/chemin/absolu/vers/compost-yolo/configs/data.yaml

# Expiration des sessions web par inactivité (minutes).
AUTH_INACTIVITY_MINUTES=30

# ── Canvas : version réduite servie pour l'annotation ─────────────────────────
# Côté max (px) au-delà duquel /api/images/{id}/fichier sert une réduction
# JPEG mise en cache (générée au premier accès). Les coordonnées sont
# normalisées : la taille servie n'a aucun effet sur les boîtes.
# L'original reste intact et accessible (?original=true).
REDUCTION_MAX_COTE=2048
# Répertoire du cache des réductions, jamais mêlé aux originaux.
# Défaut : {STORAGE_ROOT}/.cache_reduites
# REDUCTION_CACHE_DIR=/chemin/absolu/vers/cache_reduites

# ── Worker de pré-annotation ──────────────────────────────────────────────────
# Poids YOLO (requis par le worker seul ; le serveur web démarre sans).
WEIGHTS_PATH=/chemin/absolu/vers/weights/best.pt
# Seuil de confiance minimal — bas exprès, à calibrer avec
# `python -m app.worker essai` avant la première file complète.
WORKER_CONF_THRESHOLD=0.10
# Plafond de détections par image (max historique observé : 9 boîtes/image).
WORKER_MAX_DET=20
# Attente entre deux passes quand la file est vide (secondes).
WORKER_POLL_SECONDS=5
# Tentatives avant qu'une image en échec soit « garée » (hors file, visible
# dans l'avancement des lots).
WORKER_MAX_ATTEMPTS=3
# Échecs consécutifs avant arrêt du worker (panne systémique probable).
WORKER_MAX_CONSECUTIVE_FAILURES=5

# ── Variables du docker-compose (déploiement uniquement) ──────────────────────
POSTGRES_DB=compost_annotation
POSTGRES_USER=compost
POSTGRES_PASSWORD=A_REMPLACER
# POSTGRES_PORT=5432

[Desktop Entry]
Type=Application
Name=Compost Kiosk (Docker)
Comment=Autorise l'affichage X11 pour le conteneur puis (re)lance le kiosque Compost
Exec=sh -c "xhost +local: ; cd ~/Compost_Jetson && docker compose up -d"
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
